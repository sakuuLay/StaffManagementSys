<!-- Tomcat context.xml datasource example -->
<Context>
  <!-- Replace username/password, url and driverClassName for your DB -->
  <Resource name="jdbc/SMDB" auth="Container" type="javax.sql.DataSource"
            maxTotal="20" maxIdle="10" maxWaitMillis="10000"
            username="dbuser" password="dbpass" driverClassName="com.mysql.cj.jdbc.Driver"
            url="jdbc:mysql://localhost:3306/sm_db?useSSL=false&serverTimezone=UTC"/>
</Context>
