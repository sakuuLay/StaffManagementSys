<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>RequestLeave</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
   
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        span.error {
            color: red;
            display: none;
        }
    </style>

</head>


<body>
	
    <form action="#" method="post">
        <label for="empintID">Enter an Integer:</label>
        <input type="text" id="empintID" name="eid" placeholder="ID" pattern="^-?\d+$" required>
        <span id="errorInt" class="error">Please enter a valid (integer) number.</span><br>

        <label for="empname">Enter your name:</label>
        <input type="text" id="empname" name="name" placeholder="Name" required>
        <span id="errorName" class="error">Required field.</span><br>

        <label for="empdid">Enter department ID:</label>
        <input type="text" id="empdid" name="did" placeholder="Department ID" required>
        <span id="errorDept" class="error">Required field.</span><br>

        <label for="type">Leave type:</label>
        <input type="text" id="type" name="type" placeholder="Type" required>
        <span id="errorType" class="error">Required field.</span><br>

        <label for="date">Requesting date:</label>
        <input type="date" id="date" name="date" required>
        <span id="errorDate" class="error">Required field.</span><br>

        <label for="des">Description (Optional):</label>
        <input type="text" id="des" name="des" placeholder="Description (Optional)"><br>

        <button type="submit">Submit</button>
    </form>

    <script>
        // Validate integer input
        document.getElementById('empintID').addEventListener('input', function (event) {
            var input = event.target;
            var errorMessage = document.getElementById('errorInt');

            if (input.validity.patternMismatch) {
                errorMessage.style.display = 'block';
            } else {
                errorMessage.style.display = 'none';
            }
        });

        // Validate required fields
        var fields = ['empname', 'empdid', 'type', 'date'];
        fields.forEach(function (id) {
            document.getElementById(id).addEventListener('input', function (event) {
                var input = event.target;
                var errorId = 'error' + input.id.charAt(0).toUpperCase() + input.id.slice(1);
                var errorMessage = document.getElementById(errorId);

                if (input.value == '') {
                    errorMessage.style.display = 'block';
                } else {
                    errorMessage.style.display = 'none';
                }
            });
        });
    </script>
</body>
</html>